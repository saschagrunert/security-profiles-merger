{
  "executable": {
    "allowedExecutables": [
      "/usr/bin/bash",
      "/usr/bin/python"
    ],
    "allowedLibraries": [
      "/usr/lib/libc.so"
    ]
  },
  "filesystem": {
    "readOnlyPaths": [
      "/etc/config",
      "/var/log"
    ]
  },
  "capability": {
    "allowedCapabilities": [
      "CHOWN",
      "NET_ADMIN",
      "SYS_TIME"
    ]
  }
}
